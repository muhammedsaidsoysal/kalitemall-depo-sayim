<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F2F5F4">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#10241E" android:orientation="horizontal" android:padding="12dp">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="KaliteMall • Hızlı Sayım"
            android:textStyle="bold" android:textSize="17sp" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/totalText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Toplam 0" android:textColor="#B8F2D9" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="#121A18">
        <androidx.camera.view.PreviewView android:id="@+id/cameraPreview"
            android:layout_width="match_parent" android:layout_height="match_parent"
            app:implementationMode="compatible" />
        <!-- Tight code/size windows as in the approved screenshot. The actual CameraX
             OCR crops are derived directly from codeTarget and sizeTarget positions.
             Captions are OUTSIDE these crops; barcode/color/product text is excluded. -->
        <LinearLayout android:id="@+id/dualZonesOverlay"
            android:layout_width="wrap_content" android:layout_height="49dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="36dp"
            android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="20dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/codeTitle"
                    android:layout_width="80dp" android:layout_height="20dp"
                    android:text="STOK KODU" android:gravity="center"
                    android:textSize="10sp" android:textStyle="bold"
                    android:textColor="#FFFFFF" android:background="#B2186D52" />
                <Space android:id="@+id/headerGap" android:layout_width="39dp"
                    android:layout_height="20dp" />
                <TextView android:layout_width="52dp" android:layout_height="20dp"
                    android:text="BEDEN" android:gravity="center"
                    android:textSize="10sp" android:textStyle="bold"
                    android:textColor="#FFFFFF" android:background="#B2186D52" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="29dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <FrameLayout android:id="@+id/codeTarget"
                    android:layout_width="80dp" android:layout_height="29dp"
                    android:background="@drawable/scan_frame" />
                <Space android:id="@+id/guideGap" android:layout_width="39dp"
                    android:layout_height="29dp" />
                <FrameLayout android:id="@+id/sizeTarget"
                    android:layout_width="52dp" android:layout_height="29dp"
                    android:background="@drawable/scan_frame" />
            </LinearLayout>
        </LinearLayout>
        <View android:id="@+id/fullFrameGuide"
            android:layout_width="match_parent" android:layout_height="155dp"
            android:layout_gravity="center" android:layout_marginHorizontal="24dp"
            android:background="@drawable/scan_frame" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="top" android:layout_margin="14dp"
            android:gravity="center" android:padding="8dp"
            android:background="#BF10241E" android:textColor="#FFFFFF"
            android:text="Etiketi 15–25 cm mesafede tut. Titreşimde son okuma kısa süre korunur." />
        <TextView android:id="@+id/readStatusText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="bottom"
            android:layout_marginBottom="47dp" android:background="#D91B503B"
            android:textColor="#FFFFFF" android:textStyle="bold"
            android:padding="9dp" android:gravity="center" android:text="Okunan kod bekleniyor" />
        <TextView android:id="@+id/cameraStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="bottom"
            android:background="#D910241E" android:textColor="#FFFFFF"
            android:padding="10dp" android:gravity="center" android:text="Kamera bekleniyor" />
    </FrameLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="388dp"
        android:fillViewport="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <EditText android:id="@+id/boxInput" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="48dp" android:singleLine="true" android:hint="Kutu/Raf (zorunlu)"
                    android:inputType="textCapCharacters" android:text="KUTU-1" />
                <Button android:id="@+id/torchButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Fener" />
                <Button android:id="@+id/cameraButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Kamera" />
            </LinearLayout>
            <Button android:id="@+id/focusButton" android:layout_width="match_parent"
                android:layout_height="44dp" android:text="ODAKLA (gerekirse) · veya kameraya dokun" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Okunan stok kodu ve beden (düzenlenebilir)"
                android:textStyle="bold" android:textColor="#10241E" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText android:id="@+id/detectedSkuInput" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="48dp"
                    android:singleLine="true" android:inputType="textCapCharacters"
                    android:hint="317-2053-R56" />
                <EditText android:id="@+id/detectedSizeInput" android:layout_width="75dp"
                    android:layout_height="48dp" android:singleLine="true"
                    android:inputType="textCapCharacters" android:hint="40" />
            </LinearLayout>
            <Button android:id="@+id/manualAddButton" android:layout_width="match_parent"
                android:layout_height="48dp" android:text="Kontrol ettim · Manuel +1 kaydet" />
            <Switch android:id="@+id/autoSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:checked="true"
                android:text="Otomatik sayım (aynı kod + beden iki kez)" />
            <Switch android:id="@+id/fullFrameSwitch"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Etiket düzeni farklı: tüm etiketi tara (yedek)"
                android:checked="false" />
            <Button android:id="@+id/roiAdjustButton"
                android:layout_width="match_parent" android:layout_height="40dp"
                android:text="Hedef kutularını ayarla (gerektiğinde)" />
            <LinearLayout android:id="@+id/roiAdjustGroup" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:visibility="gone">
                <TextView android:id="@+id/codeWidthText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Stok kodu kutusu: 80 dp" android:textColor="#164936" />
                <SeekBar android:id="@+id/codeWidthSeek"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="110" android:progress="20" />
                <TextView android:id="@+id/gapWidthText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Kutular arası: 39 dp" android:textColor="#164936" />
                <SeekBar android:id="@+id/gapWidthSeek"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="70" android:progress="23" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Renk alanı yeşil stok kodu kutusuna giriyorsa kod kutusunu daralt. Kod kesiliyorsa biraz genişlet."
                    android:textSize="12sp" android:textColor="#475569" />
            </LinearLayout>
            <TextView android:id="@+id/rawOcrText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#475569"
                android:paddingVertical="4dp" android:maxLines="3"
                android:ellipsize="end" android:textSize="12sp"
                android:text="Kameranın gördüğü yazı: —" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="7dp" android:background="#D3F5E0"
                android:textColor="#0D5134" android:textStyle="bold"
                android:text="Dar tarama alanı: renk ve açıklama yok" />
            <TextView android:id="@+id/lastScanText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingVertical="7dp"
                android:textSize="18sp" android:textStyle="bold" android:textColor="#10241E"
                android:text="Henüz sayım yapılmadı" />
            <TextView android:id="@+id/syncStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#3D6255"
                android:text="Google Sheets: bağlantı bekleniyor" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/undoButton" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content" android:text="Son sayımı geri al" />
                <Button android:id="@+id/exportButton" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content" android:text="CSV yedeği" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="8dp" android:text="Sheets bağlantısı (bir kez)"
                android:textStyle="bold" android:textColor="#10241E" />
            <EditText android:id="@+id/scriptUrlInput" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:singleLine="true"
                android:inputType="textUri" android:hint="Apps Script /exec URL" />
            <EditText android:id="@+id/secretInput" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:singleLine="true"
                android:inputType="textPassword" android:hint="64 karakter gizli anahtar" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/connectButton" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content" android:text="Bağlantıyı test et" />
                <Button android:id="@+id/syncNowButton" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content" android:text="Bekleyenleri gönder" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#5B6C65" android:textSize="12sp"
                android:text="Sayısal güven eşiği yok: titreşim nedeniyle araya boş kare girse de 1,4 sn içinde iki aynı kod/beden okunursa sayılır. Hatalı okuma varsa otomatiği kapat, alanları düzelt ve Manuel +1 kullan. Aynı etiketi tekrar saymak için 0,6 sn boş zemin göster. Kayıt önce telefona, sonra Sheets'e yazılır." />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
